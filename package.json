{
  "name": "wildwood-voxel-sandbox",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "main": "desktop/main.cjs",
  "author": "Wildwood",
  "license": "UNLICENSED",
  "description": "A single-player voxel wilderness for Windows and the browser.",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4173 --strictPort",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test": "node --test tests/core.test.js",
    "test:browser": "node tests/browser.mjs",
    "start": "node server.mjs",
    "desktop": "electron .",
    "desktop:icons": "node desktop/create-icon.cjs",
    "desktop:build": "npm run build && npm run desktop:icons && electron-builder --win portable --x64 --publish never",
    "test:desktop": "node tests/desktop.mjs",
    "test:desktop:packaged": "node tests/desktop.mjs --packaged"
  },
  "dependencies": {
    "three": "0.180.0"
  },
  "devDependencies": {
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "playwright": "1.55.0",
    "vite": "7.1.5"
  },
  "build": {
    "appId": "com.wildwood.sandbox",
    "productName": "Wildwood",
    "asar": true,
    "npmRebuild": false,
    "directories": { "output": "desktop-release" },
    "files": ["dist/**/*", "desktop/main.cjs", "desktop/preload.cjs", "desktop/assets.cjs", "desktop/icon.ico", "desktop/icon.png", "package.json", "THIRD-PARTY-LICENSES.txt", "!node_modules/**"],
    "extraFiles": [{"from":"LEEME-ESCRITORIO.txt","to":"LEEME.txt"}],
    "win": {
      "target": [{"target":"portable","arch":["x64"]}],
      "icon": "desktop/icon.ico",
      "requestedExecutionLevel": "asInvoker",
      "artifactName": "Wildwood-Portable-${version}.exe"
    },
    "portable": { "requestExecutionLevel": "user" }
  }
}
